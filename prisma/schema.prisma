generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Curso {
  id          Int             @id @default(autoincrement())
  name        String
  description descriptionType
  level       levelType
  aula Aula[]
}

enum descriptionType {
  TECNOLOGIA
  FINANCAS
  HERMENEUTICA
  GRAMATICA
  LIBRAS
  PEDAGOGIA
  TEOLOGIA
  FILOSOFIA
  MATEMATICA
}

enum levelType {
  BASICO
  INTERMEDIARIO 
  AVANCADO 
}

model Aula {
  id      Int     @id @default(autoincrement())
  title   String
  teacher String
  school  String?
  subject String
  curso Curso @relation(fields: [cursoId ], references: [id])
  cursoId Int
}
